# Optional: direct token override. If set, local login cache and refresh are bypassed.
# CODEX_ACCESS_TOKEN=your-oauth-bearer-token

CODEX_MODEL=gpt-5.3-codex
CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
CODEX_ORIGINATOR=dotnet-console-chat
CODEX_AUTH_ISSUER=https://auth.openai.com
# CODEX_HOME=/home/you/.codex
CODEX_LOGIN_PORT=1455
# CHATGPT_ACCOUNT_ID=optional-account-id
CODEX_REASONING_EFFORT=medium
CODEX_SYSTEM_PROMPT=You are Codex, a helpful coding assistant.
